# Local default. Use a normal PostgreSQL URL for Supabase or another provider.
DATABASE_URL=sqlite:///./paper_trading.db
PAPER_ONLY=true
INITIAL_CASH=10000
MAX_ORDER_EXPOSURE=250
MAX_MARKET_EXPOSURE=1000
MAX_TOTAL_EXPOSURE=5000
MAX_DAILY_LOSS=100
MARKET_PAGE_SIZE=100
MARKET_PAGES=5
WORKER_REFRESH_SECONDS=300
WORKER_RECONNECT_SECONDS=10
MAX_MARKET_DATA_AGE_SECONDS=30
WORKER_STREAM_MARKET_LIMIT=25
WORKER_REQUIRE_CRYPTO=true
MIN_MARKET_DURATION_MINUTES=10
MAX_MARKET_DURATION_MINUTES=20
PAPER_QUEUE_MODEL=baseline
# Public, read-only account monitoring. No API key or wallet credentials.
ACCOUNT_DATA_BASE_URL=https://data-api.polymarket.com
ACCOUNT_POSITIONS_PATH=/positions
ACCOUNT_ACTIVITY_PATH=/activity
# Auto stop loss / take profit for strategy-opened positions (price offsets from entry; 0 disables)
AUTO_STOP_LOSS_OFFSET=0.05
AUTO_TAKE_PROFIT_OFFSET=0
